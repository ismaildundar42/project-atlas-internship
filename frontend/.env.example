# Frontend Environment Variables
# Bu dosya örnek şablon olarak kaynak kontrolüne dahildir.
# Gerçek değerleri içeren .env.local dosyasını bu şablona göre oluşturun.
# .env.local dosyası .gitignore kapsamındadır ve asla commit edilmez.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000

# Uygulama adı (opsiyonel, sayfa başlıkları vb. için kullanılabilir)
VITE_APP_NAME=Demir Export Proje Kütüphanesi
